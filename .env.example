# =============================================================================
# Telepath configuration
#
# Copy this file to `.env` (or run `./scripts/setup.sh` to be walked through
# the values interactively). Values without defaults must be filled in.
# =============================================================================

# --- Telegram credentials (required) -----------------------------------------
# Get TG_API_ID and TG_API_HASH at https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=your_telegram_api_hash

# Create a manager bot at @BotFather and paste its token here.
TG_MANAGER_BOT_TOKEN=1234567890:AAEhBP_REPLACE_ME_WITH_REAL_BOTFATHER_TOKEN

# Your Telegram numeric user ID. `scripts/setup.sh` fills this automatically
# from the auth step. Leave as 0 if you plan to run setup.sh.
TG_OWNER_ID=0

# Session file path (without the .session extension; Telethon adds it).
# Inside the Docker container this resolves to /app/data/telepath.session.
TG_SESSION=data/telepath

# SQLite database path. Inside Docker: /app/data/assistant.sqlite3.
TG_ASSISTANT_DB=data/assistant.sqlite3


# --- LLM provider (required) -------------------------------------------------
# One of: openai | anthropic | copilot
LLM_PROVIDER=openai

# OpenAI ---------------------------------------------------------------------
# Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional. Set to point at an OpenAI-compatible endpoint (e.g. a Codex proxy
# or a local LLM gateway). Leave empty to use OpenAI's default endpoint.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=60

# Anthropic ------------------------------------------------------------------
# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=
ANTHROPIC_TIMEOUT_SECONDS=60

# GitHub Copilot CLI ---------------------------------------------------------
# Not bundled in the Docker image. To use LLM_PROVIDER=copilot, install
# `copilot` (the GitHub Copilot CLI) on the host and run telepath without
# Docker, or extend the Dockerfile to add the CLI plus an auth volume.
COPILOT_COMMAND=copilot
COPILOT_MODEL=gpt-5-mini
COPILOT_TIMEOUT_SECONDS=300


# --- Behavior tuning (optional) ----------------------------------------------
# Minimum delay between Telegram history fetches used to decide whether a
# private chat has the >=100 messages required for transcription.
PRIVATE_HISTORY_THROTTLE_SECONDS=5

# Premium emoji wrapped around transcription replies. Empty disables decoration.
TRANSCRIPTION_DECORATION_CUSTOM_EMOJI_ID=5460795800101594035

# Post mirroring outbox delivery. Source posts are snapshotted into SQLite first,
# and downloadable media is saved under data/post_mirror_media before delivery.
# A non-current Telegram authorization opens one bounded delivery window; the
# current Telepath session is ignored as owner activity.
POST_MIRROR_ONLINE_FRESHNESS_SECONDS=180
POST_MIRROR_OUTBOX_POLL_SECONDS=30
POST_MIRROR_ONLINE_DELIVERY_WINDOW_SECONDS=300
POST_MIRROR_DELIVERY_DELAY_MIN_SECONDS=60
POST_MIRROR_DELIVERY_DELAY_MAX_SECONDS=120
